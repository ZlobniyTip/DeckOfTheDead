  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Dying zombies emit a cloud of infection that can turn the living into zombies.
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0423\u043C\u0438\u0440\u0430\u044E\u0449\u0438\u0439 \u0437\u043E\u043C\u0431\u0438
      \u0432\u044B\u0434\u0435\u043B\u044F\u0435\u0442 \u043E\u0431\u043B\u0430\u043A\u043E
      \u0438\u043D\u0444\u0435\u043A\u0446\u0438\u0438, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044C
      \u0436\u0438\u0432\u044B\u0445 \u0432 \u0437\u043E\u043C\u0431\u0438."
    Object: {fileID: 0}
  - Language: Turkish
    Text: "\xD6lmekte olan zombiler, ya\u015Fayanlar\u0131 zombilere d\xF6n\xFC\u015Ft\xFCrebilecek
      bir enfeksiyon bulutu yayar."
    Object: {fileID: 0}
